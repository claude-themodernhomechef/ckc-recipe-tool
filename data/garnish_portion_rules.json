{
  "_doc": "Per-serving portion rules for ingredients used in 'to garnish' / 'to serve' lines. Read by build_recipe_nutrition_v2.ts and any script that needs to scale garnishes from per-serving to whole-recipe quantities. ORDER MATTERS — the build script tests rules top-to-bottom and uses the first match, so MORE SPECIFIC PATTERNS must come BEFORE more general ones (e.g. 'pita chips' before 'pita').",
  "_lastUpdated": "2026-05-04",
  "_version": "1.0",
  "_schema": {
    "id": "stable identifier for the category (used in logs/UI)",
    "displayName": "human-readable name for assumption-disclosure UI",
    "perServing": { "qty": "number — qty per serving", "unit": "string — unit; '' for bare count (e.g. '1/3 avocado')" },
    "note": "human-readable per-serving note for assumption-disclosure UI (e.g. '1 oz per serving')",
    "regex": "regex string (case-insensitive). Tested against ingredient name. First match wins.",
    "skip": "OPTIONAL — true for ingredients that should be treated as 'to taste' / zero-cal (salt, pepper, etc.)"
  },
  "rules": [
    {
      "id": "small_seeds",
      "displayName": "seeds",
