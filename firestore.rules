rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own profile document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Decisions collection — read-only, same open-read policy as recipes
    match /decisions/{decisionId} {
      allow read: if true;
    }

    // Unified recipes collection:
    // - Anyone can read (internal admin tool, protected by HTML password gate)
    // - Full write access for admin review queue (no auth yet — protected by obscurity)
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if true;
    }

    // Ingredient category DB — admin tool reads + writes to assign categories
    match /ingredientCategories/{docId} {
      allow read, write: if true;
    }

    // Ingredient nutrition DB — read-only, used for live diet swap lookups
    match /ingredients/{docId} {
      allow read: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
